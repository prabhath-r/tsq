# SPDX-License-Identifier: MPL-2.0

# Keep remote builders from receiving anything the Dockerfile cannot use.
**
!.dockerignore
!Dockerfile
!LICENSE
!MANIFEST.in
!Makefile
!NOTICE
!README.md
!pyproject.toml
!start
!tsq
!benchmarks
!benchmarks/**
!corpus
!corpus/**
!experiments
!experiments/**
!scripts
!scripts/**
!src
!src/**
!tests
!tests/**

# Defense in depth inside the allowed source trees.
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage*
**/coverage.xml
**/htmlcov
**/build
**/dist
experiments/results
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal
**/*.sqlite*
**/*.log
**/.env
**/.env.*
**/*.key
**/*.pem
**/.DS_Store
